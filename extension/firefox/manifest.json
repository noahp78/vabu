{
  "manifest_version": 3,
  "name": "VABU \u2014 Virtual Agentic Browser User",
  "version": "0.4.1",
  "description": "Let VABU control Firefox HTTP(S) tabs while the local bridge is running.",
  "browser_specific_settings": {
    "gecko": {
      "id": "vabu@local.invalid",
      "strict_min_version": "128.0"
    }
  },
  "incognito": "not_allowed",
  "permissions": [
    "scripting",
    "nativeMessaging",
    "tabGroups",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "scripts": [
      "firefox/background.mjs"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "VABU",
    "default_popup": "shared/popup.html",
    "default_icon": {
      "16": "shared/icons/vabu-16.png",
      "32": "shared/icons/vabu-32.png",
      "48": "shared/icons/vabu-48.png",
      "128": "shared/icons/vabu-128.png"
    }
  },
  "icons": {
    "16": "shared/icons/vabu-16.png",
    "32": "shared/icons/vabu-32.png",
    "48": "shared/icons/vabu-48.png",
    "128": "shared/icons/vabu-128.png"
  }
}
